# Copy to .env and replace every placeholder. Never commit .env.
# These values are documentation only. They are not a real account.

# Required. Signs session and magic-link tokens.
SIMLAB_SECRET_KEY=replace-with-a-long-random-string

# The one account that can sign in. Password is hashed on startup.
# Leave SIMLAB_PASSWORD empty to disable password login and use magic links only.
SIMLAB_EMAIL=alex@example.com
SIMLAB_PASSWORD=change-me

# sqlite file. On Render/Railway/Fly, point this at a persistent disk.
SIMLAB_DATABASE_URL=sqlite:///./simlab.db

# Public URL used inside magic-link emails. No trailing path.
SIMLAB_BASE_URL=http://localhost:8000

# Local only. When true, the magic-link response includes the URL so you can
# sign in without SMTP. Leave false anywhere the app is reachable by others.
SIMLAB_DEV_EXPOSE_MAGIC_LINK=true

# Set true behind HTTPS so the session cookie is marked Secure.
SIMLAB_COOKIE_SECURE=false

# Optional SMTP for magic links. All four of host/from/user/password if your
# provider requires auth. Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
